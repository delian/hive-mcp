# Copy to .env. Nothing here is required for a first local run.
HIVE_PUBLIC_URL=http://localhost:8080        # the address clients use (tunnel/domain URL when exposed)
HIVE_EMBEDDER=onnx                           # onnx (offline) | openai | hashing (dev only)
HIVE_BIND=127.0.0.1                          # host interface for the published port
# Google Workspace sign-in (claude.ai, ChatGPT, Gemini); leave empty to use `hive token create` only
HIVE_GOOGLE_CLIENT_ID=
HIVE_GOOGLE_CLIENT_SECRET=
HIVE_GOOGLE_ALLOWED_DOMAINS=["example.com"]
HIVE_SECRET_KEY=                             # openssl rand -hex 32 (generated into the data volume if empty)
# --profile postgres
POSTGRES_PASSWORD=
# --profile cloudflare / tailscale
TUNNEL_TOKEN=
TS_AUTHKEY=
HIVE_ADMIN_UI=false                           # true: small web page at /admin (approvals, audit, usage)
HIVE_REPLICAS=1                              # >1 with the external profile; needs HIVE_SECRET_KEY (docs/DEPLOY.md)
HIVE_GROUP_MAP_FILE=                         # Workspace group sync (docs/GROUPS.md); empty = off
HIVE_GROUP_SYNC_KEY_FILE=
HIVE_GROUP_SYNC_ADMIN=
HIVE_GROUP_SYNC_MINUTES=0
HIVE_LOG_FORMAT=text                         # text | json
HIVE_LOG_LEVEL=INFO
HIVE_SEARCH_FEEDBACK=false                   # record searches + opened results for `hive eval-build` (docs/EVALUATION.md)
HIVE_RELEVANCE_FLOOR=                        # override the embedder relevance floor (`hive eval --recommend`)
HIVE_METRICS_TOKEN=                          # set to serve Prometheus metrics at /metrics (docs/OBSERVABILITY.md)
HIVE_OAUTH_REDIRECT_HOSTS=[]                  # e.g. ["claude.ai","chatgpt.com"]: refuse registration of other apps
HIVE_VECTOR_STORE=default                    # default | lancedb (experimental, embedded profile; docs/STORAGE.md)
HIVE_DIGEST_WEEKDAY=                         # 0=Mon..6=Sun: email a weekly digest (needs SMTP; docs/DIGEST.md)
HIVE_DIGEST_HOUR_UTC=8
HIVE_OCR=false                               # read scans and images (needs tesseract + poppler; docs/INGEST.md)
HIVE_OCR_LANGUAGES=eng

# "Still true?" section in the weekly digest for your own notes older than this many days (0 = off)
# HIVE_STALE_REVIEW_DAYS=180
