# Copy to .env. Nothing here is required for a first local run.
HIVE_PUBLIC_URL=http://localhost:8080        # the address clients use (tunnel/domain URL when exposed)
HIVE_EMBEDDER=onnx                           # onnx (offline) | openai | hashing (dev only)
HIVE_BIND=127.0.0.1                          # host interface for the published port
# Google Workspace sign-in (claude.ai, ChatGPT, Gemini); leave empty to use `hive token create` only
HIVE_GOOGLE_CLIENT_ID=
HIVE_GOOGLE_CLIENT_SECRET=
HIVE_GOOGLE_ALLOWED_DOMAINS=["example.com"]
HIVE_SECRET_KEY=                             # openssl rand -hex 32 (generated into the data volume if empty)
# --profile postgres
POSTGRES_PASSWORD=
# --profile cloudflare / tailscale
TUNNEL_TOKEN=
TS_AUTHKEY=
HIVE_ADMIN_UI=false                           # true: small web page at /admin (approvals, audit, usage)
HIVE_REPLICAS=1                              # >1 with the external profile; needs HIVE_SECRET_KEY (docs/DEPLOY.md)
HIVE_GROUP_MAP_FILE=                         # Workspace group sync (docs/GROUPS.md); empty = off
HIVE_GROUP_SYNC_KEY_FILE=
HIVE_GROUP_SYNC_ADMIN=
HIVE_GROUP_SYNC_MINUTES=0
